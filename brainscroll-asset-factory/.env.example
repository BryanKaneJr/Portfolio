# Required for real generation. Never commit the real key.
OPENAI_API_KEY=

# Image model. Any OpenAI image model name works; set it explicitly.
OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=medium        # empty value omits the parameter
# OPENAI_IMAGE_SIZE=1024x1024
# Extra request parameters as JSON, merged last. null removes a default, e.g.
# OPENAI_IMAGE_PARAMS={"quality":"high"}
# OPENAI_IMAGE_PARAMS={"background":null,"output_format":null,"response_format":"b64_json"}

# Text + vision model for concept checks and metadata (must accept image input)
# OPENAI_TEXT_MODEL=gpt-4.1-mini

# Keep at 1 while running style tests (max 3)
CONCURRENCY=1

# PORT=4321
# STYLE_VERSION=brainscroll-core-v1
# MOCK_OPENAI=1
