# Copy to app/.env.local (gitignored) to use a real Supabase project.
# Leave the Supabase values empty to run the development harness (simulated
# accounts, every code is 123456). There is no guest mode in either.
# Check them with: npm run supabase:check
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# The anon / publishable key ONLY. Never a service_role or sb_secret_ key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Native Google sign-in (public client ids, not secrets). Leave empty to hide
# Google on iOS/Android until the Google Cloud OAuth clients exist.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Store builds only: refuse to start without Supabase instead of using the harness.
# EXPO_PUBLIC_RELEASE=1
