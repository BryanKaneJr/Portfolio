      "prompt": "The oldest reliably dated cave art is a hand stencil. Where was it found?",
      "options": [
        {
          "id": "a",
          "label": "Lascaux, France",
          "correct": false,
          "rationale": "Lascaux is about 17,000 years old."
        },
        {
          "id": "b",
          "label": "Muna island, Indonesia",
          "correct": true
        },
        {
          "id": "c",
          "label": "Blombos Cave, South Africa",
          "correct": false,
          "rationale": "Blombos has a drawing, not the oldest stencil."
        },
        {
          "id": "d",
          "label": "Göbekli Tepe, Turkey",
          "correct": false,
          "rationale": "That's carved stone pillars."
        }
      ],
      "explanation": "A hand stencil in Liang Metanduno cave on Muna island is at least 67,800 years old.",
      "difficulty": 0.3
    },
    {
      "id": "question.art_history.100.q2",
      "kind": "mcq",
      "purpose": "understanding",
      "conceptIds": [
        "concept.art_history.art_eras"
      ],
      "sourceCardIds": [
        "card.art_history.001.c3"
      ],
      "prompt": "Which list puts four big eras of art in the right order?",
      "options": [
        {
          "id": "a",
          "label": "Renaissance, Middle Ages, Baroque, modern",
          "correct": false,
          "rationale": "The Middle Ages came before the Renaissance."
        },
        {
          "id": "b",
          "label": "Middle Ages, Baroque, Renaissance, modern",
          "correct": false,
          "rationale": "The Baroque followed the Renaissance."
        },
        {
          "id": "c",
          "label": "Middle Ages, Renaissance, Baroque, modern",
          "correct": true
        },
        {
          "id": "d",
          "label": "Baroque, Middle Ages, modern, Renaissance",
          "correct": false,
          "rationale": "Modern comes last."
        }
      ],
      "explanation": "Stone Age, ancient, Middle Ages, Renaissance, Baroque, then modern from the mid-1800s.",
      "difficulty": 0.4
    },
    {
      "id": "question.art_history.100.q3",
      "kind": "mcq",
      "purpose": "understanding",
      "conceptIds": [
        "concept.art_history.brancusi_trial",
        "concept.art_history.art_definition_debate"
      ],
      "sourceCardIds": [
        "card.art_history.002.c3",
        "card.art_history.002.c1"
      ],
      "prompt": "Why did US customs refuse to treat Brancusi's Bird in Space as a sculpture in 1926?",
      "options": [
        {
          "id": "a",
          "label": "It was made of bronze, not stone",
          "correct": false,
          "rationale": "Bronze sculptures were fine; the issue was likeness."
        },
        {
          "id": "b",
          "label": "Brancusi hadn't signed it",
          "correct": false,
          "rationale": "The dispute was about what sculpture was."
        },
        {
          "id": "c",
          "label": "It was too large to be art",
          "correct": false,
          "rationale": "Size wasn't the issue."
        },
        {
          "id": "d",
          "label": "Sculpture was expected to imitate natural models",
          "correct": true
        }
      ],
      "explanation": "Courts then treated sculpture as the likeness of natural models, and Bird in Space didn't look like a bird.",
      "difficulty": 0.45
    },
    {
      "id": "question.art_history.100.q4",
      "kind": "mcq",
      "purpose": "connection",
      "conceptIds": [
        "concept.art_history.complementary_colors",
        "concept.art_history.composition_eye_path"
      ],
      "sourceCardIds": [
        "card.art_history.004.c4",
        "card.art_history.092.c3"
      ],
      "prompt": "An artist wants a red focal point to jump out. Which trick from Levels 4 and 92 works best?",
      "options": [
        {
          "id": "a",
          "label": "Surround it with green, its complement",
          "correct": true
        },
        {
          "id": "b",
          "label": "Mix it with green until it's brown",
          "correct": false,
          "rationale": "Mixed complements go brown and dull."
        },
        {
          "id": "c",
          "label": "Place it beside orange",
          "correct": false,
          "rationale": "Orange is a neighbor, not a contrast."
        },
        {
          "id": "d",
          "label": "Make it the same size as everything else",
          "correct": false,
          "rationale": "Emphasis comes from contrast."
        }
      ],
      "explanation": "Emphasis comes from contrast, and complements side by side make each other look more intense.",
      "difficulty": 0.45
    },
    {
      "id": "question.art_history.100.q5",
      "kind": "mcq",
      "purpose": "recall",
      "conceptIds": [
