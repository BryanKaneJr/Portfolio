      "prompt": "Lascaux closed to the public in 1963 after visitors damaged it. Which museum job from ICOM's definition does that match?",
      "options": [
        {
          "id": "a",
          "label": "Exhibiting",
          "correct": false,
          "rationale": "Closing it meant not exhibiting."
        },
        {
          "id": "b",
          "label": "Collecting",
          "correct": false,
          "rationale": "Nothing was collected."
        },
        {
          "id": "c",
          "label": "Researching",
          "correct": false,
          "rationale": "Closing was about protection."
        },
        {
          "id": "d",
          "label": "Conserving",
          "correct": true
        }
      ],
      "explanation": "Closing Lascaux protected what was left: conservation, one of a museum's five jobs.",
      "difficulty": 0.4
    },
