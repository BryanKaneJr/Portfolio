      "prompt": "A painting said to be from the 1600s contains cobalt blue. Why is that a red flag?",
      "options": [
        {
          "id": "a",
          "label": "Cobalt blue fades too quickly",
          "correct": false,
          "rationale": "The problem is when it was made."
        },
        {
          "id": "b",
          "label": "Cobalt blue wasn't made until the 1800s",
          "correct": true
        },
        {
          "id": "c",
          "label": "Painters of the 1600s never used blue",
          "correct": false,
          "rationale": "They used other blues."
        },
        {
          "id": "d",
          "label": "Cobalt blue is only used in frescoes",
          "correct": false,
          "rationale": "It's about the date, not the technique."
        }
      ],
      "explanation": "Cobalt blue wasn't made until the 1800s, so a 1600s painting can't contain it.",
      "difficulty": 0.4
    },
