      "options": [
        {
          "id": "a",
          "label": "A 1950s restoration; care is everything",
          "correct": false,
          "rationale": "Its fame came from the 1911 theft."
        },
        {
          "id": "b",
          "label": "Its high price; money keeps art alive",
          "correct": false,
          "rationale": "It was the theft that made it famous."
        },
        {
          "id": "c",
          "label": "Its size; big works are remembered",
          "correct": false,
          "rationale": "It was the theft that made it famous."
        },
        {
          "id": "d",
          "label": "The 1911 theft; attention keeps art alive",
          "correct": true
        }
      ],
      "explanation": "The theft made headlines and the painting world-famous: works that are seen and talked about stay alive.",
