        "card.art_history.091.c3"
      ],
      "prompt": "What's the right order of Feldman's four steps for looking at art?",
      "options": [
        {
          "id": "a",
          "label": "Describe, analyze, interpret, judge",
          "correct": true
        },
        {
          "id": "b",
          "label": "Judge, describe, analyze, interpret",
          "correct": false,
          "rationale": "Judgment waits until the end."
        },
        {
          "id": "c",
          "label": "Interpret, describe, judge, analyze",
          "correct": false,
          "rationale": "Description comes first."
        },
        {
          "id": "d",
          "label": "Analyze, judge, describe, interpret",
          "correct": false,
          "rationale": "Describe first, judge last."
        }
      ],
      "explanation": "Describe, analyze, interpret, then judge: opinion comes last.",
      "difficulty": 0.3
    },
    {
      "id": "question.art_history.100.q6",
      "kind": "mcq",
      "purpose": "understanding",
      "conceptIds": [
        "concept.art_history.composition_rule_of_thirds"
      ],
      "sourceCardIds": [
        "card.art_history.092.c4"
      ],
      "prompt": "A photographer sets the horizon on a line one third up, not across the middle. What guideline is that?",
      "options": [
        {
          "id": "a",
          "label": "Radial balance",
          "correct": false,
          "rationale": "Radial balance fans out from a center."
        },
        {
          "id": "b",
          "label": "Symmetrical balance",
          "correct": false,
          "rationale": "That would center things."
        },
        {
          "id": "c",
          "label": "The rule of thirds",
          "correct": true
        },
        {
          "id": "d",
          "label": "Memento mori",
          "correct": false,
          "rationale": "That's a symbol, from Level 93."
        }
      ],
      "explanation": "The rule of thirds divides a picture into nine parts and puts important things along the lines.",
      "difficulty": 0.35
    },
    {
      "id": "question.art_history.100.q7",
      "kind": "mcq",
      "purpose": "understanding",
      "conceptIds": [
        "concept.art_history.symbol_memento_mori"
      ],
      "sourceCardIds": [
        "card.art_history.093.c2"
      ],
      "prompt": "A 1600s still life shows a skull, a snuffed-out candle, books and wine. What's its message?",
      "options": [
        {
          "id": "a",
          "label": "Life is short and worldly pleasures pass",
          "correct": true
        },
        {
          "id": "b",
          "label": "The owner was a wealthy scholar",
          "correct": false,
          "rationale": "The objects are symbols, not an inventory."
        },
        {
          "id": "c",
          "label": "Wine and books are good for you",
          "correct": false,
          "rationale": "It's a warning, not advice."
        },
        {
          "id": "d",
          "label": "The painter liked to paint candles",
          "correct": false,
          "rationale": "Together, the objects carry a message."
        }
      ],
      "explanation": "It's a vanitas: a reminder of mortality and the worthlessness of worldly pleasures.",
      "difficulty": 0.35
    },
    {
      "id": "question.art_history.100.q8",
      "kind": "mcq",
      "purpose": "connection",
