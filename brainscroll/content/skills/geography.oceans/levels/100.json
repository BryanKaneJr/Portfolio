      "prompt": "Oceans Mastery: which agreement, in force since January 2026, lets countries create protected areas on the high seas?",
      "options": [
        {
          "id": "a",
          "label": "The High Seas Treaty (BBNJ Agreement)",
          "correct": true
        },
        {
          "id": "b",
          "label": "The IMO Net-Zero Framework",
          "correct": false,
          "rationale": "That's about ship emissions."
        },
        {
          "id": "c",
          "label": "The global plastics treaty",
          "correct": false,
          "rationale": "Those talks have not reached agreement."
        },
        {
          "id": "d",
          "label": "A pirate code of conduct",
          "correct": false,
          "rationale": "Not a modern treaty."
        }
      ],
      "explanation": "The High Seas Treaty entered into force on January 17, 2026, under the Law of the Sea convention.",
      "difficulty": 0.5
    },
