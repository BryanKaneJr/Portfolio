        "concept.oceans.ocean_sustains_life"
      ],
      "sourceCardIds": [
        "card.oceans.001.c3"
      ],
      "prompt": "Oceans Mastery: roughly what share of Earth's oxygen comes from the ocean?",
      "options": [
        {
          "id": "a",
          "label": "About a tenth",
          "correct": false,
          "rationale": "Far too little."
        },
        {
          "id": "b",
          "label": "About half",
          "correct": true
        },
        {
          "id": "c",
          "label": "Almost none",
          "correct": false,
          "rationale": "Ocean plankton make a huge share."
        },
        {
          "id": "d",
          "label": "All of it",
          "correct": false,
          "rationale": "Land plants make the rest."
        }
      ],
      "explanation": "About half of Earth's oxygen comes from the ocean, made by photosynthesizing plankton.",
      "difficulty": 0.3
    },
    {
      "id": "question.oceans.100.q2",
      "kind": "mcq",
      "purpose": "understanding",
      "conceptIds": [
        "concept.oceans.salinity"
      ],
      "sourceCardIds": [
        "card.oceans.005.c2"
      ],
      "prompt": "Oceans Mastery: seawater is about 35 parts per thousand salt. What share of its weight is dissolved salt?",
      "options": [
        {
          "id": "a",
          "label": "About 0.35%",
          "correct": false,
          "rationale": "Ten times too little."
        },
        {
          "id": "b",
          "label": "About 3.5%",
          "correct": true
        },
        {
          "id": "c",
          "label": "About 35%",
          "correct": false,
          "rationale": "Ten times too much."
        },
        {
          "id": "d",
          "label": "About 50%",
          "correct": false,
          "rationale": "Far too much."
        }
      ],
      "explanation": "35 parts per thousand is 3.5% by weight.",
      "difficulty": 0.4
    },
    {
      "id": "question.oceans.100.q3",
      "kind": "mcq",
      "purpose": "connection",
      "conceptIds": [
        "concept.oceans.light_fades_colors",
        "concept.oceans.ocean_blue_absorption"
      ],
      "sourceCardIds": [
        "card.oceans.008.c1",
        "card.oceans.008.c2",
        "card.oceans.007.c2"
      ],
      "prompt": "Oceans Mastery: why does a red fish look dark 100 m down?",
      "options": [
        {
          "id": "a",
          "label": "Deep fish change color to hide",
          "correct": false,
          "rationale": "The fish is the same; the light has changed."
        },
        {
          "id": "b",
          "label": "Pressure squeezes the color out",
          "correct": false,
          "rationale": "Pressure doesn't change color."
        },
        {
          "id": "c",
          "label": "Water absorbs red light first, so none is left to reflect",
          "correct": true
        },
        {
          "id": "d",
          "label": "Salt stains fish dark",
          "correct": false,
          "rationale": "It's about light, not salt."
        }
      ],
      "explanation": "Water absorbs red light most strongly, so a few meters down the red is gone; nothing red is left to bounce off the fish.",
      "difficulty": 0.45
    },
    {
      "id": "question.oceans.100.q4",
      "kind": "mcq",
      "purpose": "recall",
      "conceptIds": [
        "concept.oceans.water_pressure_depth"
      ],
      "sourceCardIds": [
        "card.oceans.009.c3"
      ],
      "prompt": "Oceans Mastery: about how many atmospheres of pressure does water add at 100 m down?",
      "options": [
        {
          "id": "a",
          "label": "About 1",
          "correct": false,
          "rationale": "That's at 10 m."
        },
        {
          "id": "b",
          "label": "About 10",
          "correct": true
        },
        {
          "id": "c",
          "label": "About 100",
          "correct": false,
          "rationale": "That would be about 1,000 m."
        },
        {
          "id": "d",
          "label": "About 1,000",
          "correct": false,
          "rationale": "Far too much."
        }
      ],
      "explanation": "Water adds about one atmosphere per 10 m, so about 10 atmospheres at 100 m.",
      "difficulty": 0.4
    },
    {
      "id": "question.oceans.100.q5",
      "kind": "mcq",
      "purpose": "recall",
      "conceptIds": [
        "concept.oceans.fishing_aquaculture_rise"
      ],
      "sourceCardIds": [
        "card.oceans.091.c5"
      ],
      "prompt": "Oceans Mastery: in 2024, about what share of the world's aquatic animal production came from farms?",
      "options": [
        {
          "id": "a",
          "label": "About 5%",
          "correct": false,
          "rationale": "Far too low."
        },
        {
          "id": "b",
          "label": "About 25%",
          "correct": false,
          "rationale": "Too low."
        },
        {
          "id": "c",
          "label": "About 53%",
          "correct": true
        },
        {
          "id": "d",
          "label": "About 95%",
          "correct": false,
          "rationale": "The wild catch is still 92 million tonnes."
        }
      ],
      "explanation": "Aquaculture produced 103 million tonnes in 2024, about 53% of all aquatic animals.",
      "difficulty": 0.45
    },
    {
      "id": "question.oceans.100.q6",
      "kind": "mcq",
      "purpose": "recall",
      "conceptIds": [
        "concept.oceans.overfishing_stock_status"
      ],
      "sourceCardIds": [
        "card.oceans.092.c2"
      ],
      "prompt": "Oceans Mastery: Canada's 1992 ban on northern cod fishing was expected to last two years. How long did it last?",
      "options": [
        {
          "id": "a",
          "label": "Three years",
          "correct": false,
          "rationale": "Far longer."
        },
        {
          "id": "b",
          "label": "Ten years",
          "correct": false,
          "rationale": "Longer still."
        },
        {
          "id": "c",
          "label": "32 years",
          "correct": true
        },
        {
          "id": "d",
          "label": "It is still in force today",
          "correct": false,
          "rationale": "A cautious fishery reopened in 2024."
        }
      ],
      "explanation": "The moratorium lasted 32 years; a cautious commercial cod fishery reopened in 2024.",
      "difficulty": 0.45
    },
    {
      "id": "question.oceans.100.q7",
      "kind": "mcq",
      "purpose": "understanding",
      "conceptIds": [
        "concept.oceans.shipping_carries_trade"
      ],
      "sourceCardIds": [
        "card.oceans.093.c3"
      ],
      "prompt": "Oceans Mastery: why did Malcolm McLean's 1956 containers transform shipping?",
      "options": [
        {
          "id": "a",
          "label": "Whole boxes made loading far cheaper than loose cargo",
          "correct": true
        },
        {
          "id": "b",
          "label": "They made ships sail much faster",
          "correct": false,
          "rationale": "The saving was in loading."
        },
        {
          "id": "c",
          "label": "They let ships cross the ocean without fuel",
          "correct": false,
          "rationale": "Ships still burn fuel."
        },
        {
          "id": "d",
          "label": "They kept cargo cold",
          "correct": false,
          "rationale": "The point was cheap loading."
        }
      ],
      "explanation": "Loading loose cargo cost more than $5.80 a ton; loading McLean's containers cost about 16 cents.",
      "difficulty": 0.5
    },
    {
      "id": "question.oceans.100.q8",
      "kind": "mcq",
      "purpose": "understanding",
      "conceptIds": [
        "concept.oceans.pollution_dead_zones"
      ],
      "sourceCardIds": [
        "card.oceans.095.c3"
      ],
      "prompt": "Oceans Mastery: what actually removes the oxygen in a dead zone?",
      "options": [
        {
          "id": "a",
          "label": "Oil floating on the surface",
          "correct": false,
          "rationale": "Dead zones come from nutrient runoff."
        },
        {
          "id": "b",
          "label": "Fish breathing too much",
          "correct": false,
          "rationale": "Fish leave or die."
        },
        {
          "id": "c",
          "label": "Salt from rivers",
          "correct": false,
          "rationale": "It's about nutrients and algae."
        },
        {
          "id": "d",
          "label": "Algae dying and rotting",
          "correct": true
        }
      ],
      "explanation": "Nutrients feed algae blooms; as the algae die and decompose, the rotting uses up the oxygen.",
      "difficulty": 0.5
    },
    {
      "id": "question.oceans.100.q9",
