  "cards": [
    {
      "id": "card.ancient_greece.030.c1",
      "type": "text",
      "role": "hook",
      "headline": "Chapter 3 finale: in Athens, a lottery counted as more democratic than a vote.",
      "body": "That sounds backwards today. Here’s why it made sense to Athenians, and then the whole story of how their democracy grew."
    },
    {
      "id": "card.ancient_greece.030.c2",
      "type": "comparison",
      "headline": "Chosen by lot, or by vote?",
      "items": [
        {
          "label": "By lot",
          "points": [
            "Most officials, from 487-486 BCE",
            "The Council of 500",
            "The jury courts"
          ]
        },
        {
          "label": "By vote",
          "points": [
            "The ten generals, like Pericles",
            "Some financial officials"
          ]
        }
      ]
    },
    {
      "id": "card.ancient_greece.030.c3",
      "type": "text",
      "role": "explain",
      "headline": "Why a lottery?",
      "body": "Aristotle wrote that appointing officials by lot is thought democratic, and electing them oligarchic, meaning rule by the few. A lottery gives every eligible citizen the same chance, whoever his friends are. Athens used it for most offices from 487-486 BCE, and kept elections for jobs like general. That’s how a man like Pericles could win again and again, while councillors and jurors were simply drawn."
    },
    {
      "id": "card.ancient_greece.030.c4",
      "type": "timeline",
      "headline": "How Athens built its democracy",
      "events": [
        {
          "when": "About 594 BCE",
          "label": "Solon cancels debts and frees debt slaves"
        },
        {
          "when": "508–507 BCE",
          "label": "Cleisthenes creates ten tribes and the Council of 500"
        },
        {
          "when": "488–487 BCE",
          "label": "Athens holds its first ostracism"
        },
        {
          "when": "451–450 BCE",
          "label": "Pericles’ law: citizens need two Athenian parents"
        },
        {
          "when": "447 BCE",
          "label": "Work begins on the Parthenon"
        }
      ]
    },
