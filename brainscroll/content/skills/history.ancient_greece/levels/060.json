  "cards": [
    {
      "id": "card.ancient_greece.060.c1",
      "type": "text",
      "role": "hook",
      "headline": "Thinkers finale: a teacher, his student, and his student’s student.",
      "body": "Socrates taught Plato, and Plato taught Aristotle. Each learned from the one before, then went his own way."
    },
    {
      "id": "card.ancient_greece.060.c2",
      "type": "comparison",
      "headline": "Three ways to the truth",
      "items": [
        {
          "label": "Socrates",
          "points": [
            "Wrote nothing; asked questions",
            "Tested definitions until they broke",
            "Knew that he didn’t know"
          ]
        },
        {
          "label": "Plato",
          "points": [
            "Wrote dialogues starring Socrates",
            "Senses show only shadows",
            "Truth lies in the perfect Forms"
          ]
        },
        {
          "label": "Aristotle",
          "points": [
            "Argued against Plato’s Forms",
            "Studied 500+ animal species",
            "Virtue is a middle point"
          ]
        }
      ]
    },
    {
      "id": "card.ancient_greece.060.c3",
      "type": "timeline",
      "headline": "Schools of Athens",
      "events": [
        {
          "when": "399 BCE",
          "label": "Athens puts Socrates to death"
        },
        {
          "when": "380s BCE",
          "label": "Plato opens the Academy"
        },
        {
          "when": "335 BCE",
          "label": "Aristotle opens the Lyceum"
        },
        {
          "when": "About 306 BCE",
          "label": "Epicurus opens the Garden"
        },
        {
          "when": "About 300 BCE",
          "label": "Zeno’s Stoics meet at the Painted Porch"
        }
      ]
    },
    {
      "id": "card.ancient_greece.060.c4",
      "type": "text",
      "role": "explain",
      "headline": "One city, many arguments",
      "body": "Look where it all happened: every school on that timeline was in or just outside Athens. Each thinker learned from someone and then pushed back. Aristotle put truth before his friend Plato; Anaximander swapped his teacher’s water for the boundless. Greek philosophy didn’t hand down one set of answers. It handed down the habit of questioning your teacher."
    },
