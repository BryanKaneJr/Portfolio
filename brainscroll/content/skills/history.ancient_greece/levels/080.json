  "cards": [
    {
      "id": "card.ancient_greece.080.c1",
      "type": "text",
      "role": "hook",
      "headline": "Theater and the Arts finale: most of it is lost. What survived got lucky.",
      "body": "Plays, poems, statues and pots each reached us by a different road. Follow the roads, and you’ve reviewed the chapter."
    },
    {
      "id": "card.ancient_greece.080.c2",
      "type": "comparison",
      "headline": "Made, and what’s left",
      "items": [
        {
          "label": "Tragedies",
          "points": [
            "Three poets wrote about 300",
            "About 33 survive complete"
          ]
        },
        {
          "label": "Sappho’s poems",
          "points": [
            "Nine books in Alexandria",
            "One poem whole, plus fragments"
          ]
        },
        {
          "label": "Bronze statues",
          "points": [
            "Most were melted down",
            "The sea and Roman copies kept some"
          ]
        }
      ]
    },
    {
      "id": "card.ancient_greece.080.c3",
      "type": "text",
      "role": "explain",
      "headline": "Four lucky roads",
      "body": "Look at how the survivors got here. Later readers kept copying what they liked, which is why Euripides, with few festival wins, outlasted his rivals. Egypt gave back papyrus: Menander’s Dyskolos, and scraps of Sappho from a rubbish dump and a mummy’s wrapping. The sea hid the Riace warriors from anyone who wanted their metal. And Roman copies in marble kept lost bronzes alive. Survival wasn’t a prize for quality. It was taste and luck."
    },
    {
      "id": "card.ancient_greece.080.c4",
      "type": "timeline",
      "headline": "The chapter on one line",
      "events": [
        {
          "when": "About 610–570 BCE",
          "label": "Sappho sings on Lesbos"
        },
        {
          "when": "About 530 BCE",
          "label": "Red-figure painting begins in Athens"
        },
        {
          "when": "Just after 480 BCE",
          "label": "The Kritios Boy shifts his weight"
        },
        {
          "when": "458 BCE",
          "label": "Aeschylus stages the Oresteia"
        },
        {
          "when": "405 BCE",
          "label": "Aristophanes’s Frogs wins first prize"
        },
        {
          "when": "334 BCE",
          "label": "Earliest surviving Corinthian columns"
        }
      ]
    },
