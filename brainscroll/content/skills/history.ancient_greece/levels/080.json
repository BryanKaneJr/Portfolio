      "prompt": "Theater and the Arts recap: at most, how many speaking actors did a Greek tragedy use?",
      "options": [
        {
          "id": "a",
          "label": "One",
          "correct": false,
          "rationale": "That was the start, with Thespis."
        },
        {
          "id": "b",
          "label": "Two",
          "correct": false,
          "rationale": "Aeschylus’s step; Sophocles went further."
        },
        {
          "id": "c",
          "label": "Three",
          "correct": true
        },
        {
          "id": "d",
          "label": "Fifteen",
          "correct": false,
          "rationale": "That’s the size of a chorus."
        }
      ],
      "explanation": "Aeschylus added a second actor and Sophocles a third, and tragedy never used more than three speaking actors.",
      "difficulty": 0.2
