  "questions": [
    {
      "id": "question.ancient_greece.100.q1",
      "kind": "mcq",
      "purpose": "recall",
      "conceptIds": [
        "concept.ancient_greece.greece_eras"
      ],
      "sourceCardIds": [
        "card.ancient_greece.001.c2",
        "card.ancient_greece.001.c3"
      ],
      "prompt": "Which era of ancient Greece ran from about 480 to 323 BCE, the stretch most postcards show?",
      "options": [
        {
          "id": "a",
          "label": "The Dark Age",
          "correct": false,
          "rationale": "That ran from about 1200 to 800 BCE."
        },
        {
          "id": "b",
          "label": "The Archaic age",
          "correct": false,
          "rationale": "That ran from about 800 to 480 BCE."
        },
        {
          "id": "c",
          "label": "The Classical age",
          "correct": true
        },
        {
          "id": "d",
          "label": "The Hellenistic age",
          "correct": false,
          "rationale": "That began in 323 BCE."
        }
      ],
      "explanation": "The Classical age ran from about 480 BCE to Alexander’s death in 323 BCE.",
      "difficulty": 0.35
    },
    {
      "id": "question.ancient_greece.100.q2",
      "kind": "mcq",
      "purpose": "understanding",
      "conceptIds": [
        "concept.ancient_greece.greek_mountains_and_sea"
      ],
      "sourceCardIds": [
        "card.ancient_greece.002.c2"
      ],
      "prompt": "Athens and Thebes lay less than 100 km apart. Why did they treat each other as foreign rivals?",
      "options": [
        {
          "id": "a",
          "label": "Mountains kept Greek communities apart",
          "correct": true
        },
        {
          "id": "b",
          "label": "A wide sea separated the two cities",
          "correct": false,
          "rationale": "They were neighbors on land."
        },
        {
          "id": "c",
          "label": "They spoke unrelated languages",
          "correct": false,
          "rationale": "Both were Greek."
        },
        {
          "id": "d",
          "label": "Rome forbade them to meet",
          "correct": false,
          "rationale": "Rome came much later."
        }
      ],
      "explanation": "Mountains made overland travel hard, so communities grew up separately and independently.",
      "difficulty": 0.4
    },
    {
      "id": "question.ancient_greece.100.q3",
      "kind": "mcq",
      "purpose": "recall",
      "conceptIds": [
        "concept.ancient_greece.minoan_crete"
      ],
      "sourceCardIds": [
        "card.ancient_greece.003.c3"
      ],
      "prompt": "Why can’t historians read the Minoans’ own records?",
      "options": [
        {
          "id": "a",
          "label": "The Minoans never wrote anything",
          "correct": false,
          "rationale": "They wrote in Linear A."
        },
        {
          "id": "b",
          "label": "Evans burned the tablets",
          "correct": false,
          "rationale": "He rebuilt, he didn’t burn."
        },
        {
          "id": "c",
          "label": "Their records were in Egyptian",
          "correct": false,
          "rationale": "Their script was Linear A."
        },
        {
          "id": "d",
          "label": "Their Linear A script is still undeciphered",
          "correct": true
        }
      ],
      "explanation": "The Minoans’ main script, Linear A, has never been deciphered.",
      "difficulty": 0.35
    },
    {
      "id": "question.ancient_greece.100.q4",
      "kind": "mcq",
      "purpose": "understanding",
      "conceptIds": [
        "concept.ancient_greece.troy_archaeology"
      ],
      "sourceCardIds": [
        "card.ancient_greece.005.c4",
        "card.ancient_greece.005.c5"
      ],
      "prompt": "A documentary says archaeologists have found Homer’s Troy exactly as the poems describe it. What’s the best correction?",
      "options": [
        {
          "id": "a",
          "label": "Troy was invented by Homer",
          "correct": false,
          "rationale": "Its ruins lie at Hisarlik."
        },
        {
          "id": "b",
          "label": "Troy was real, but the ten-year war is unproven",
          "correct": true
        },
        {
          "id": "c",
          "label": "Troy lies under Athens",
          "correct": false,
          "rationale": "It lies at Hisarlik in Turkey."
        },
        {
          "id": "d",
          "label": "Schliemann proved every detail",
          "correct": false,
          "rationale": "His “Priam’s Treasure” was far too old."
        }
      ],
      "explanation": "Troy was a real city at Hisarlik, but a war on the scale of Homer’s ten-year siege may never have happened.",
      "difficulty": 0.45
    },
    {
      "id": "question.ancient_greece.100.q5",
      "kind": "mcq",
      "purpose": "connection",
      "conceptIds": [
        "concept.ancient_greece.homeric_question",
        "concept.ancient_greece.legacy_texts_survival"
      ],
      "sourceCardIds": [
        "card.ancient_greece.006.c4",
        "card.ancient_greece.097.c2"
      ],
      "prompt": "Homer’s epics began in an oral tradition. What is the oldest complete written Iliad that survives today?",
      "options": [
        {
          "id": "a",
          "label": "A Linear B tablet from Mycenae",
          "correct": false,
          "rationale": "Linear B records were inventories."
        },
        {
          "id": "b",
          "label": "Homer’s own scroll",
          "correct": false,
          "rationale": "No such scroll survives."
        },
        {
          "id": "c",
          "label": "The Venetus A, a 10th-century manuscript",
          "correct": true
        },
        {
          "id": "d",
          "label": "An Arabic translation by Hunayn",
          "correct": false,
          "rationale": "The Venetus A is a Greek manuscript."
        }
      ],
      "explanation": "The Venetus A, from the end of the 10th century CE, is the oldest complete text of the Iliad.",
      "difficulty": 0.45
    },
    {
      "id": "question.ancient_greece.100.q6",
      "kind": "mcq",
      "purpose": "connection",
      "conceptIds": [
        "concept.ancient_greece.greek_colonies",
        "concept.ancient_greece.legacy_greece_misconceptions"
      ],
      "sourceCardIds": [
        "card.ancient_greece.009.c4",
        "card.ancient_greece.098.c4"
      ],
      "prompt": "Greek colonists helped found Cumae, in Italy. According to one theory, what did Romans meeting Greeks there help give us?",
      "options": [
        {
          "id": "a",
          "label": "The word alphabet",
          "correct": false,
          "rationale": "That comes from alpha and beta."
        },
        {
          "id": "b",
          "label": "The name “Greek”",
          "correct": true
        },
        {
          "id": "c",
          "label": "The Olympic Games",
          "correct": false,
          "rationale": "Those were revived in 1896."
        },
        {
          "id": "d",
          "label": "The word democracy",
          "correct": false,
          "rationale": "That comes from demos and kratos."
        }
      ],
      "explanation": "One theory traces Latin Graeci, and so “Greek”, to settlers from Graia who helped found Cumae.",
      "difficulty": 0.5
    },
    {
      "id": "question.ancient_greece.100.q7",
      "kind": "mcq",
      "purpose": "understanding",
      "conceptIds": [
        "concept.ancient_greece.legacy_democracy_then_now"
      ],
      "sourceCardIds": [
        "card.ancient_greece.092.c2",
        "card.ancient_greece.092.c3"
      ],
      "prompt": "How did Athenian democracy differ from most democracies today?",
      "options": [
        {
          "id": "a",
          "label": "Citizens voted directly, but only adult men could",
          "correct": true
        },
        {
          "id": "b",
          "label": "Everyone voted, including slaves",
          "correct": false,
          "rationale": "Slaves were excluded."
        },
        {
          "id": "c",
          "label": "A king chose the representatives",
          "correct": false,
          "rationale": "Citizens voted themselves."
        },
        {
          "id": "d",
          "label": "Women ran the Assembly",
          "correct": false,
          "rationale": "Women were excluded."
        }
      ],
      "explanation": "Athenian citizens voted on laws themselves, but only adult male citizens could take part.",
      "difficulty": 0.45
    },
    {
      "id": "question.ancient_greece.100.q8",
      "kind": "mcq",
      "purpose": "recall",
      "conceptIds": [
        "concept.ancient_greece.legacy_modern_olympics"
      ],
      "sourceCardIds": [
        "card.ancient_greece.093.c4"
      ],
      "prompt": "A friend says the Olympic torch relay was run by the ancient Greeks. When did it actually begin?",
      "options": [
        {
          "id": "a",
          "label": "At Olympia in 776 BCE",
          "correct": false,
          "rationale": "There was no ancient relay."
        },
        {
          "id": "b",
          "label": "In Athens in 1896",
          "correct": false,
          "rationale": "The first modern Games had no relay."
        },
        {
          "id": "c",
          "label": "With the 1936 Berlin Games",
          "correct": true
        },
        {
          "id": "d",
          "label": "In Rome under the emperors",
          "correct": false,
          "rationale": "It began in 1936."
        }
      ],
      "explanation": "The torch relay was created for the 1936 Berlin Games; ancient Greeks never ran one.",
      "difficulty": 0.4
    },
    {
      "id": "question.ancient_greece.100.q9",
      "kind": "mcq",
      "purpose": "understanding",
      "conceptIds": [
        "concept.ancient_greece.legacy_greece_misconceptions"
      ],
      "sourceCardIds": [
        "card.ancient_greece.098.c2",
        "card.ancient_greece.098.c3"
      ],
      "prompt": "A film shows gleaming, pure-white Greek statues. What would the sculptors have expected to see?",
      "options": [
        {
          "id": "a",
          "label": "Bare marble, just as shown",
          "correct": false,
          "rationale": "They painted their sculptures."
        },
        {
          "id": "b",
          "label": "Statues covered in gold leaf",
          "correct": false,
          "rationale": "The evidence is for paint."
        },
        {
          "id": "c",
          "label": "Painted statues in bright colors",
          "correct": true
        },
        {
          "id": "d",
          "label": "Statues of plain bronze only",
          "correct": false,
          "rationale": "Marble statues were painted."
        }
      ],
      "explanation": "Greek sculptures were painted; the white look came from lost and removed paint.",
      "difficulty": 0.4
    },
    {
      "id": "question.ancient_greece.100.q10",
      "kind": "mcq",
      "purpose": "connection",
      "conceptIds": [
        "concept.ancient_greece.trojan_war_legend",
        "concept.ancient_greece.legacy_myths_retold"
      ],
      "sourceCardIds": [
        "card.ancient_greece.005.c3",
        "card.ancient_greece.095.c4"
      ],
      "prompt": "Neither the wooden horse nor Achilles’ heel appears in the Iliad. What do the two share?",
      "options": [
        {
          "id": "a",
          "label": "Both were invented by Hollywood",
          "correct": false,
          "rationale": "Both are far older than film."
        },
        {
          "id": "b",
          "label": "Famous details can come from other tellings",
          "correct": true
        },
        {
          "id": "c",
          "label": "Homer described both at length",
          "correct": false,
          "rationale": "Neither is in the Iliad."
        },
        {
          "id": "d",
          "label": "Both are proven by archaeology",
          "correct": false,
          "rationale": "They are stories, not finds."
        }
      ],
      "explanation": "The horse appears in the Odyssey and the Aeneid, and the heel was added by later tellers.",
      "difficulty": 0.5
    }
