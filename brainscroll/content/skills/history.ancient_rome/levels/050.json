  "cards": [
    {
      "id": "card.ancient_rome.050.c1",
      "type": "text",
      "role": "hook",
      "headline": "Milestone: halfway to Mastery. How did a republic become an empire?",
      "body": "In about a century, Rome went from Tiberius Gracchus to an emperor, and it kept its Senate the whole way. Let’s trace the road."
    },
    {
      "id": "card.ancient_rome.050.c2",
      "type": "text",
      "role": "explain",
      "headline": "Same forms, new master",
      "body": "The Republic didn’t end with a sign on the Senate door. Its forms stayed, the Senate and consuls included, so one man’s rule still looked like a republic, while real power passed to him. Even the word emperor gives the game away. It comes from imperator, a title soldiers gave to a victorious commander. Not a word from the Senate or the voters. A word from the army."
    },
    {
      "id": "card.ancient_rome.050.c3",
      "type": "timeline",
      "headline": "The road to one-man rule: follow the armies",
      "events": [
        {
          "when": "133 BCE",
          "label": "Tiberius Gracchus proposes land reform"
        },
        {
          "when": "88 BCE",
          "label": "Sulla marches his army on Rome"
        },
        {
          "when": "49 BCE",
          "label": "Caesar crosses the Rubicon with his army"
        },
        {
          "when": "44 BCE",
          "label": "Caesar is assassinated"
        },
        {
          "when": "31 BCE",
          "label": "Octavian’s fleet wins at Actium"
        },
        {
          "when": "27 BCE",
          "label": "Octavian becomes Augustus"
        }
      ]
    },
    {
      "id": "card.ancient_rome.050.c4",
      "type": "comparison",
      "headline": "Republic and Principate",
      "items": [
        {
          "label": "Republic",
          "points": [
            "Two consuls, elected each year",
            "Each consul could block the other"
          ]
        },
        {
          "label": "Principate",
          "points": [
            "One princeps, ruling until death",
            "Senate and consuls kept, legions his"
          ]
        }
      ]
    },
