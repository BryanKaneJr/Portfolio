      "sourceCardIds": [
        "card.ancient_rome.050.c2",
        "card.ancient_rome.044.c3"
      ],
      "prompt": "Why did the Republic’s forms survive under Augustus?",
      "options": [
        {
          "id": "a",
          "label": "They made one man’s rule look like a republic",
          "correct": true
        },
        {
          "id": "b",
          "label": "The Senate still controlled the legions",
          "correct": false,
          "rationale": "Augustus controlled most of them."
        },
        {
          "id": "c",
          "label": "The consuls could still overrule Augustus",
          "correct": false,
          "rationale": "Real power was his."
        },
        {
          "id": "d",
          "label": "Rome had no other way to name its years",
          "correct": false,
          "rationale": "The reason was political."
        }
      ],
      "explanation": "Keeping the Senate and consuls let Augustus hold real power without looking like a king.",
      "difficulty": 0.4
    },
