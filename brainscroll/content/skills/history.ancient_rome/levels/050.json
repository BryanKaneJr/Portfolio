    {
      "id": "card.ancient_rome.050.c1",
      "type": "text",
      "role": "hook",
      "headline": "Milestone: halfway to Mastery. How did a republic become an empire?",
      "body": "In about a century, Rome went from the Gracchi to an emperor. Let’s trace the path."
    },
    {
      "id": "card.ancient_rome.050.c2",
      "type": "text",
      "role": "explain",
      "headline": "Same forms, new master",
      "body": "The change from Republic to Empire kept republican forms, such as the Senate and the consuls, while real power passed to one man. Even the word emperor is borrowed from the army: it comes from imperator, a title soldiers gave to a victorious commander."
    },
    {
      "id": "card.ancient_rome.050.c3",
      "type": "timeline",
      "headline": "The road to one-man rule",
      "events": [
        {
          "when": "133 BCE",
          "label": "Tiberius Gracchus proposes land reform"
        },
        {
          "when": "88 BCE",
          "label": "Sulla marches on Rome"
        },
        {
          "when": "49 BCE",
          "label": "Caesar crosses the Rubicon"
        },
        {
          "when": "44 BCE",
          "label": "Caesar is assassinated"
        },
        {
          "when": "31 BCE",
          "label": "Octavian wins at Actium"
        },
        {
          "when": "27 BCE",
          "label": "Octavian becomes Augustus"
        }
      ]
    },
    {
      "id": "card.ancient_rome.050.c4",
      "type": "comparison",
      "headline": "Republic and Principate",
      "items": [
        {
          "label": "Republic",
          "points": [
            "Two consuls, elected each year",
            "Power limited by time and colleagues"
          ]
        },
        {
          "label": "Principate",
          "points": [
            "One princeps, ruling until death",
            "Senate and consuls kept, but weaker"
          ]
        }
      ]
