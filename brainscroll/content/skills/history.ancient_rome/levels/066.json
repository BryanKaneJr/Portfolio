    {
      "id": "card.ancient_rome.066.c1",
      "type": "text",
      "role": "hook",
      "headline": "For a Roman, the bath was the gym, the café and the office."
    },
    {
      "id": "card.ancient_rome.066.c2",
      "type": "text",
      "role": "explain",
      "headline": "Hot, warm, cold",
      "body": "Large public baths, thermae, had hot, warm and cold rooms: the caldarium, tepidarium and frigidarium. They were heated by the hypocaust: hot air from furnaces flowed under raised floors and through the walls.",
      "callout": "Hypocaust: underfloor heating"
    },
    {
      "id": "card.ancient_rome.066.c3",
      "type": "text",
      "role": "explain",
      "headline": "Why Romans went",
      "body": "Baths were social centers where Romans exercised, talked, did business and relaxed, and entry was cheap. The Baths of Caracalla, opened in the 3rd century CE, could serve about 1,600 bathers at a time."
    },
    {
      "id": "card.ancient_rome.066.c4",
      "type": "fact",
      "fact": "Romans cleaned themselves without soap.",
      "context": "Bathers oiled their skin and scraped it clean with a curved metal tool, the strigil. The oil and dirt came off together."
    },
