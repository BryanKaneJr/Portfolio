    {
      "id": "card.ancient_rome.087.c2",
      "type": "text",
      "role": "explain",
      "headline": "The last pagan emperor",
      "body": "Julian, Constantine’s nephew, became sole emperor in 361 CE. He rejected Christianity and tried to restore worship of the traditional gods. He was the last Roman emperor to follow the old gods."
    },
    {
      "id": "card.ancient_rome.087.c3",
      "type": "text",
      "role": "explain",
      "headline": "A short reign",
      "body": "Christians called him Julian the Apostate: an apostate is someone who abandons their faith. He was killed on campaign against Persia in 363 CE, and his religious program died with him.",
      "callout": "Apostate: someone who abandons their faith"
    },
    {
      "id": "card.ancient_rome.087.c4",
      "type": "fact",
      "fact": "Julian banned Christians from teaching classical literature.",
      "context": "He wanted the old poets and philosophers taught only by people who still honored the old gods themselves."
    },
