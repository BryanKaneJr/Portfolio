    {
      "id": "card.ancient_rome.095.c1",
      "type": "text",
      "role": "hook",
      "headline": "The Roman Empire lasted until 1453, if you count the East.",
      "body": "The eastern half, ruled from Constantinople, outlived the West by nearly a thousand years."
    },
    {
      "id": "card.ancient_rome.095.c2",
      "type": "text",
      "role": "explain",
      "headline": "Romans in the East",
      "body": "Historians call the Eastern Roman Empire the Byzantine Empire, but its people called themselves Romans. Its capital was Constantinople, dedicated by Constantine in 330 CE. Over time Greek replaced Latin as the language of its government."
    },
    {
      "id": "card.ancient_rome.095.c3",
      "type": "text",
      "role": "explain",
      "headline": "Justinian’s ambition",
      "body": "In the 6th century CE, Justinian reconquered Italy and North Africa for a time. He also had Roman law collected, and built the great church of Hagia Sophia in Constantinople, finished in 537 CE."
    },
    {
      "id": "card.ancient_rome.095.c4",
      "type": "fact",
      "fact": "Constantinople fell in 1453 CE.",
      "context": "Sultan Mehmed II led the Ottoman capture of the city, more than a thousand years after Constantine dedicated it in 330 CE."
    },
    {
