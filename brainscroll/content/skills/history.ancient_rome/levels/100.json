      "prompt": "According to legend, what raised the twins Romulus and Remus?",
      "options": [
        {
          "id": "a",
          "label": "A shepherd’s goat",
          "correct": false,
          "rationale": "It was a wild animal."
        },
        {
          "id": "b",
          "label": "A she-wolf",
          "correct": true
        },
        {
          "id": "c",
          "label": "A Vestal priestess",
          "correct": false,
          "rationale": "It was a wild animal."
        },
        {
          "id": "d",
          "label": "An eagle",
          "correct": false,
          "rationale": "It was a wild animal."
        }
      ],
      "explanation": "Legend said the abandoned twins were nursed by a she-wolf.",
      "difficulty": 0.1
    },
    {
      "id": "question.ancient_rome.100.q2",
      "kind": "mcq",
      "purpose": "understanding",
      "conceptIds": [
        "concept.ancient_rome.consuls"
      ],
      "sourceCardIds": [
        "card.ancient_rome.012.c2"
      ],
      "prompt": "Why did the Republic elect two consuls for one-year terms?",
      "options": [
        {
          "id": "a",
          "label": "Rome had two capitals",
          "correct": false,
          "rationale": "It had one city."
        },
        {
          "id": "b",
          "label": "One ruled Rome and one the provinces",
          "correct": false,
          "rationale": "Both led the state."
        },
        {
          "id": "c",
          "label": "So no one person held power for long",
          "correct": true
        },
        {
          "id": "d",
          "label": "Because one always died in battle",
          "correct": false,
          "rationale": "The reason was limits on power."
        }
      ],
      "explanation": "Two colleagues who could block each other, for one year only, kept anyone from supreme power.",
      "difficulty": 0.3
    },
    {
      "id": "question.ancient_rome.100.q3",
      "kind": "mcq",
      "purpose": "understanding",
      "conceptIds": [
        "concept.ancient_rome.tribunes"
      ],
      "sourceCardIds": [
        "card.ancient_rome.016.c3"
      ],
      "prompt": "What did a tribune do by declaring “Veto”?",
      "options": [
        {
          "id": "a",
          "label": "Called the Senate to meet",
          "correct": false,
          "rationale": "It blocked an action."
        },
        {
          "id": "b",
          "label": "Blocked a magistrate’s action",
          "correct": true
        },
        {
          "id": "c",
          "label": "Declared war on an enemy",
          "correct": false,
          "rationale": "It blocked an action."
        },
        {
          "id": "d",
          "label": "Freed an enslaved person",
          "correct": false,
          "rationale": "It blocked an action."
        }
      ],
      "explanation": "A tribune could block another magistrate’s act by saying “Veto,” “I forbid.”",
      "difficulty": 0.3
    },
