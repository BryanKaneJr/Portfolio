      "prompt": "Why do Orthodox and Western Christians often celebrate Easter on different Sundays?",
      "options": [
        {
          "id": "a",
          "label": "Orthodox churches calculate it by the Julian calendar",
          "correct": true
        },
        {
          "id": "b",
          "label": "Orthodox churches ignore the full moon",
          "correct": false,
          "rationale": "Both follow the same kind of rule."
        },
        {
          "id": "c",
          "label": "Western churches fix Easter on March 21",
          "correct": false,
          "rationale": "March 21 is the equinox date in the rule, not Easter itself."
        },
        {
          "id": "d",
          "label": "Orthodox churches celebrate Christmas instead",
          "correct": false,
          "rationale": "They celebrate Easter too."
        }
      ],
      "explanation": "The rule is the same kind, but Orthodox churches apply it on the older Julian calendar, so their Easter usually comes later.",
      "difficulty": 0.35
    },
