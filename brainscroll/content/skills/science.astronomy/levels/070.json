      "role": "hook",
      "headline": "Chapter 7 finale. One number decides a star’s whole life story.",
      "body": "That number is its mass."
    },
    {
      "id": "card.astronomy.070.c2",
      "type": "text",
      "role": "explain",
      "headline": "Two paths",
      "body": "A star’s final fate depends mainly on its mass. A Sun-like star swells into a red giant, sheds a planetary nebula and ends as a white dwarf. A star far more massive than the Sun explodes as a supernova and leaves behind something much stranger: a neutron star or a black hole.",
      "callout": "Sun-like → white dwarf · Massive → neutron star or black hole"
    },
    {
      "id": "card.astronomy.070.c3",
      "type": "timeline",
      "headline": "A Sun-like star’s life",
      "events": [
        {
          "when": "Birth",
          "label": "Collapses from a cloud of gas and dust"
        },
        {
          "when": "Main sequence",
          "label": "Fuses hydrogen for billions of years"
        },
        {
          "when": "Red giant",
          "label": "Core runs low on hydrogen; outer layers swell"
        },
        {
          "when": "The end",
          "label": "Sheds a planetary nebula; a white dwarf remains"
        }
      ]
    },
