      "options": [
        {
          "id": "a",
          "label": "Watching for transits",
          "correct": false,
          "rationale": "Transits reveal planets."
        },
        {
          "id": "b",
          "label": "Measuring its parallax",
          "correct": true
        },
        {
          "id": "c",
          "label": "Listening for gravitational waves",
          "correct": false,
          "rationale": "Those come from colliding black holes and neutron stars."
        },
        {
          "id": "d",
          "label": "Reading its spectral lines",
          "correct": false,
          "rationale": "Spectra reveal composition."
        }
      ],
      "explanation": "Parallax, the star’s tiny shift as Earth orbits the Sun, gives the distance to nearby stars.",
