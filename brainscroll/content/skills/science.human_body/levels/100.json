  "questions": [
    {
      "id": "question.human_body.100.q1",
      "kind": "mcq",
      "purpose": "recall",
      "conceptIds": [
        "concept.human_body.organ_systems"
      ],
      "sourceCardIds": [
        "card.human_body.001.c2"
      ],
      "prompt": "Mastery: which organ system filters waste from your blood and balances your body's water?",
      "options": [
        {
          "id": "a",
          "label": "Lymphatic",
          "correct": false,
          "rationale": "It returns fluid and defends against germs."
        },
        {
          "id": "b",
          "label": "Digestive",
          "correct": false,
          "rationale": "It processes food."
        },
        {
          "id": "c",
          "label": "Urinary",
          "correct": true
        },
        {
          "id": "d",
          "label": "Endocrine",
          "correct": false,
          "rationale": "It sends hormones."
        }
      ],
      "explanation": "The urinary system removes waste from the blood and balances water.",
      "difficulty": 0.25
    },
    {
      "id": "question.human_body.100.q2",
      "kind": "mcq",
      "purpose": "recall",
      "conceptIds": [
        "concept.human_body.gene_to_protein"
      ],
      "sourceCardIds": [
        "card.human_body.006.c4"
      ],
      "prompt": "Mastery: what carries a gene's message out of the nucleus to a ribosome?",
      "options": [
        {
          "id": "a",
          "label": "Messenger RNA",
          "correct": true
        },
        {
          "id": "b",
          "label": "A red blood cell",
          "correct": false,
          "rationale": "Mature red blood cells have no nucleus at all."
        },
        {
          "id": "c",
          "label": "A mitochondrion",
          "correct": false,
          "rationale": "Mitochondria supply energy."
        },
        {
          "id": "d",
          "label": "A hormone",
          "correct": false,
          "rationale": "Hormones carry signals between organs."
        }
      ],
      "explanation": "In transcription a gene is copied into messenger RNA, which carries the message to a ribosome in the cytoplasm.",
      "difficulty": 0.35
    },
    {
      "id": "question.human_body.100.q3",
      "kind": "mcq",
      "purpose": "understanding",
      "conceptIds": [
        "concept.human_body.microbe_ratio"
      ],
      "sourceCardIds": [
        "card.human_body.008.c2"
      ],
      "prompt": "Mastery: textbooks long said bacteria vastly outnumber your own cells. What did the 2016 recount find?",
      "options": [
        {
          "id": "a",
          "label": "Bacteria outnumber cells 100 to 1",
          "correct": false,
          "rationale": "The 2016 recount overturned the big ratio."
        },
        {
          "id": "b",
          "label": "There are no bacteria in a healthy body",
          "correct": false,
          "rationale": "About 38 trillion live in the colon."
        },
        {
          "id": "c",
          "label": "Human cells outnumber bacteria 10 to 1",
          "correct": false,
          "rationale": "The two are roughly equal."
        },
        {
          "id": "d",
          "label": "Roughly one bacterium per human cell",
          "correct": true
        }
      ],
      "explanation": "Sender, Fuchs and Milo estimated about 38 trillion bacteria to 30 trillion human cells: roughly one to one.",
      "difficulty": 0.35
    },
    {
      "id": "question.human_body.100.q4",
      "kind": "mcq",
      "purpose": "recall",
      "conceptIds": [
        "concept.human_body.health_diet_who_limits"
      ],
      "sourceCardIds": [
        "card.human_body.091.c4"
      ],
      "prompt": "Mastery: WHO's salt limit is under 5 g a day. About how much is that in the kitchen?",
      "options": [
        {
          "id": "a",
          "label": "A pinch",
          "correct": false,
          "rationale": "5 g is more than a pinch."
        },
        {
          "id": "b",
          "label": "Just under a teaspoon",
          "correct": true
        },
        {
          "id": "c",
          "label": "A tablespoon",
          "correct": false,
          "rationale": "That's several times the limit."
        },
        {
          "id": "d",
          "label": "A whole cup",
          "correct": false,
          "rationale": "Far over the limit."
        }
      ],
      "explanation": "WHO describes under 5 g of salt a day as just under a teaspoon.",
      "difficulty": 0.3
    },
    {
      "id": "question.human_body.100.q5",
      "kind": "mcq",
      "purpose": "recall",
      "conceptIds": [
        "concept.human_body.health_activity_guidelines"
      ],
      "sourceCardIds": [
        "card.human_body.092.c2"
      ],
      "prompt": "Mastery: under WHO's 2020 guidelines, how much moderate activity a week is recommended for adults aged 18 to 64?",
      "options": [
        {
          "id": "a",
          "label": "15 to 30 minutes",
          "correct": false,
          "rationale": "Far below the guideline."
        },
        {
          "id": "b",
          "label": "60 to 90 minutes",
          "correct": false,
          "rationale": "Still below the guideline."
        },
        {
          "id": "c",
          "label": "150 to 300 minutes",
          "correct": true
        },
        {
          "id": "d",
          "label": "1,000 minutes or more",
          "correct": false,
          "rationale": "Far more than the guideline asks."
        }
      ],
      "explanation": "WHO recommends adults do 150 to 300 minutes of moderate activity a week, or 75 to 150 of vigorous activity.",
      "difficulty": 0.35
    },
    {
      "id": "question.human_body.100.q6",
      "kind": "mcq",
      "purpose": "understanding",
      "conceptIds": [
        "concept.human_body.health_sleep_benefits"
      ],
      "sourceCardIds": [
        "card.human_body.093.c4"
      ],
      "prompt": "Mastery: how does non-REM sleep give your heart a lighter shift?",
      "options": [
        {
          "id": "a",
          "label": "The heart stops for a few minutes",
          "correct": false,
          "rationale": "The heart keeps beating, just more gently."
        },
        {
          "id": "b",
          "label": "Heart rate and blood pressure fall",
          "correct": true
        },
        {
          "id": "c",
          "label": "Blood drains out of the heart",
          "correct": false,
          "rationale": "Nothing drains; the work eases."
        },
        {
          "id": "d",
          "label": "The lungs take over pumping",
          "correct": false,
          "rationale": "The heart still pumps, just less hard."
        }
      ],
      "explanation": "During non-REM sleep heart rate and blood pressure fall, so the heart doesn't work as hard.",
      "difficulty": 0.35
    },
    {
      "id": "question.human_body.100.q7",
      "kind": "mcq",
      "purpose": "understanding",
      "conceptIds": [
        "concept.human_body.health_stress_response"
      ],
      "sourceCardIds": [
        "card.human_body.094.c3"
      ],
      "prompt": "Mastery: after a scare passes, what calms the stress response back down?",
      "options": [
        {
          "id": "a",
          "label": "A fresh surge of adrenaline",
          "correct": false,
          "rationale": "Adrenaline is the gas, not the brake."
        },
        {
          "id": "b",
          "label": "Cortisol rising higher",
          "correct": false,
          "rationale": "Cortisol falls as the threat passes."
        },
        {
          "id": "c",
          "label": "The amygdala sending more alarms",
          "correct": false,
          "rationale": "That's how the alarm starts."
        },
        {
          "id": "d",
          "label": "The parasympathetic nervous system, the brake",
          "correct": true
        }
      ],
      "explanation": "When the threat passes, cortisol falls and the parasympathetic nervous system acts as a brake on the response.",
      "difficulty": 0.4
    },
    {
      "id": "question.human_body.100.q8",
      "kind": "mcq",
      "purpose": "understanding",
      "conceptIds": [
        "concept.human_body.health_uv_protection"
      ],
      "sourceCardIds": [
        "card.human_body.095.c4"
      ],
      "prompt": "Mastery: a friend says a deep tan proves their skin is healthy. What does the CDC say?",
      "options": [
        {
          "id": "a",
          "label": "A tan means skin is fully protected",
          "correct": false,
          "rationale": "The CDC says the opposite."
        },
        {
          "id": "b",
          "label": "Any tan or burn after UV is a sign of injury",
          "correct": true
        },
        {
          "id": "c",
          "label": "Only a burn counts as damage",
          "correct": false,
          "rationale": "A tan counts too."
        },
        {
          "id": "d",
          "label": "Tans make vitamin D unnecessary",
          "correct": false,
          "rationale": "The CDC's point is about injury."
        }
      ],
      "explanation": "The CDC says any change in skin color after UV exposure, tan or burn, is a sign of injury, not health.",
      "difficulty": 0.35
    },
    {
      "id": "question.human_body.100.q9",
      "kind": "mcq",
      "purpose": "connection",
      "conceptIds": [
        "concept.human_body.health_placebo_control",
        "concept.human_body.health_myth_testing"
      ],
      "sourceCardIds": [
        "card.human_body.096.c4",
        "card.human_body.099.c5"
      ],
      "prompt": "Mastery: which kind of trial showed that sugar doesn't make kids hyper?",
      "options": [
        {
          "id": "a",
          "label": "Double-blind trials, where no one knew who had sugar",
          "correct": true
        },
        {
          "id": "b",
          "label": "Asking parents what they had noticed",
          "correct": false,
          "rationale": "Parents' impressions were the source of the myth."
        },
        {
          "id": "c",
          "label": "Studies of animal behavior only",
          "correct": false,
          "rationale": "The trials studied children."
        },
        {
          "id": "d",
          "label": "One child tested once",
          "correct": false,
          "rationale": "A single case proves little."
        }
      ],
      "explanation": "In double-blind trials neither children nor researchers knew who got sugar, and no behavior difference showed up.",
      "difficulty": 0.4
    },
    {
      "id": "question.human_body.100.q10",
      "kind": "mcq",
      "purpose": "connection",
      "conceptIds": [
        "concept.human_body.organization_levels",
        "concept.human_body.health_transplant_first"
      ],
