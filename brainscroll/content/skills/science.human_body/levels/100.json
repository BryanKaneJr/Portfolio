        "card.human_body.004.c2",
        "card.human_body.098.c3"
      ],
      "prompt": "Mastery: the Herrick twins' 1954 operation moved a kidney. On Level 4's ladder, what level is a kidney?",
      "options": [
        {
          "id": "a",
          "label": "A cell",
          "correct": false,
          "rationale": "A kidney is made of many tissues and cells."
        },
        {
          "id": "b",
          "label": "A tissue",
          "correct": false,
          "rationale": "Kidneys combine two or more tissue types."
        },
        {
          "id": "c",
          "label": "An organ",
          "correct": true
        },
        {
          "id": "d",
          "label": "A whole organism",
          "correct": false,
          "rationale": "That's the full body."
        }
      ],
      "explanation": "An organ is a distinct structure made of two or more tissue types; the kidney is one, part of the urinary system.",
      "difficulty": 0.35
    }
