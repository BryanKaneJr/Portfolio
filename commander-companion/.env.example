# -----------------------------------------------------------------------------
# Commander Companion — environment template
# Copy to `.env` and fill in. NEVER commit a real `.env`.
# All variables are validated at startup by @cc/shared/env (Zod). Missing or
# malformed required values cause a fast, explicit boot failure.
# -----------------------------------------------------------------------------

# Runtime
NODE_ENV=development

# Database (Postgres / Supabase). Use the pooled connection for the app and the
# direct connection for migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/commander_companion?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/commander_companion?schema=public"

# Supabase (server-side only unless prefixed NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server-only; never expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI — SERVER ONLY. The browser must never receive this key (blueprint §5.2).
OPENAI_API_KEY=
OPENAI_ANSWER_MODEL=gpt-economical    # placeholder: set after pricing research (Phase 0)
OPENAI_COMPLEX_MODEL=gpt-strong       # placeholder: escalation route only
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Feature flags & cost controls
AI_ENABLED=true                       # kill switch: false keeps card/deck tools working
ANON_DAILY_QUOTA=10
ACCOUNT_DAILY_QUOTA=50
MONTHLY_SPEND_LIMIT_USD=50

# Ingestion
SCRYFALL_USER_AGENT="CommanderCompanion/0.0 (+https://github.com/BryanKaneJr/portfolio)"
RULES_SOURCE_URL="https://media.wizards.com/"   # confirm exact URL during Phase 0 research
