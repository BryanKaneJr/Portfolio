{
  "name": "crowns-of-europe",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "jest",
    "validate": "tsx scripts/validate-content.ts && tsx scripts/check-terms.ts",
    "map:build": "tsx scripts/build-map.ts",
    "relief:build": "tsx scripts/build-relief.ts",
    "icons:build": "tsx scripts/build-icons.ts",
    "icons": "node scripts/make-icons.mjs",
    "soak": "tsx scripts/dev/soak.ts",
    "export:web": "expo export --platform web",
    "screens": "expo export --platform web && node scripts/screens.mjs && node scripts/screens-war.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "check": "npm run typecheck && npm run lint && npm run validate && npm test"
  },
  "dependencies": {
    "@expo-google-fonts/cinzel": "^0.4.2",
    "@expo-google-fonts/im-fell-english": "^0.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.27",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/d3-delaunay": "^6.0.4",
    "@types/d3-geo": "^3.1.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.2",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-server": "^3.0.4",
    "@types/topojson-simplify": "^3.0.3",
    "d3-delaunay": "^6.0.4",
    "d3-geo": "^3.1.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jpeg-js": "^0.4.4",
    "playwright": "^1.56.1",
    "pngjs": "^3.4.0",
    "polygon-clipping": "^0.15.7",
    "polylabel": "^2.1.0",
    "prettier": "^3.9.9",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "world-atlas": "^2.0.2"
  }
}
