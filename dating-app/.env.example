# Copy to backend/.env and fill in.
PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://dating:dating@localhost:5432/dating_app
JWT_SECRET=replace-me-with-a-long-random-string

# Dev-only login provider. Set to 1 to enable POST /auth/dev/callback with a
# handle in the "code" field. Never enable in production.
DEV_AUTH=1

# Meta / Facebook Login
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=datingapp://auth/facebook

# Instagram Basic Display
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=datingapp://auth/instagram

# Cloud storage (S3-compatible). If left blank the backend falls back to
# a local /uploads sink so photos/stories still work in dev.
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Optional CDN base for public reads. Falls back to the S3 virtual-hosted URL.
S3_PUBLIC_BASE_URL=

# Push (Expo push API needs no key by default; FCM/APNs would go here)
EXPO_ACCESS_TOKEN=
