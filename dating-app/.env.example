# Copy to backend/.env and fill in.
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dating_app
JWT_SECRET=replace-me-with-a-long-random-string

# Meta / Facebook Login
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=datingapp://auth/facebook

# Instagram Basic Display
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=datingapp://auth/instagram

# Cloud storage (S3-compatible)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Push (Expo push API needs no key by default; FCM/APNs would go here)
EXPO_ACCESS_TOKEN=
